rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security, schema validation, and sanitization
    function isValidDateString(dateStr) {
      return dateStr is string && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isReasonableSize() {
      // Prevents oversized document injections while easily accommodating all fields and compressed images
      return request.resource.data.size() < 200;
    }

    // Daily Activity Reports (IT Daily Operations & Logbook)
    match /daily_activities/{date} {
      allow read: if true;
      allow create, update: if isValidDateString(date)
        && request.resource.data.date == date
        && request.resource.data.propertyName is string
        && request.resource.data.updatedAt is number
        && isReasonableSize();
      allow delete: if isValidDateString(date);
    }

    // Daily Checklist Reports (31 Tasks Morning & Evening Operations)
    match /daily_checklists/{date} {
      allow read: if true;
      allow create, update: if isValidDateString(date)
        && request.resource.data.date == date
        && request.resource.data.propertyName is string
        && request.resource.data.items is list
        && request.resource.data.updatedAt is number
        && isReasonableSize();
      allow delete: if isValidDateString(date);
    }

    // Weekly Maintenance Reports (Weekly IT Operations & Custom Reports)
    match /weekly_reports/{weekId} {
      allow read: if true;
      allow create, update: if request.resource.data.propertyName is string
        && request.resource.data.updatedAt is number
        && isReasonableSize();
      allow delete: if true;
    }

    // App Settings (Company Logo, IT PIC Team Members, Client Users, Departments, Server Thresholds, Routine Activities)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if settingId in ['company_logo', 'team_members', 'client_users', 'departments', 'server_thresholds', 'routine_activities']
        && isReasonableSize();
    }

    // Health Check Ping for online latency & connectivity monitor
    match /_health_check/{docId} {
      allow read, write: if docId == 'ping';
    }

    // Connection test document (Firebase Skill)
    match /test/{docId} {
      allow read: if true;
    }

    // Lock down all other document paths by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
